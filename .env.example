# ═══════════════════════════════════════════════════════════════
# The deployed entrypoint (`python run.py`) now makes the note→code decision with
# claude_coder.pipeline.code_encounter, NOT app.pipeline (issue #6, Codex finding
# F6-R4-A1). Settings marked [VESTIGIAL] below are therefore no longer read by
# anything the deployment runs. They are kept, not deleted, because the tools that
# read them (tools/*.py) still exist and are still runnable by hand; a variable with
# no [VESTIGIAL] marker is live.
# ═══════════════════════════════════════════════════════════════

# ── LLM provider ─────────────────────────────────────────────
# "claude" (recommended, default) or "openai" — selects the CODING model only
LLM_PROVIDER=claude

# Anthropic — ALWAYS REQUIRED, regardless of LLM_PROVIDER: PDF extraction
# uses Claude Vision even when the coding passes run on OpenAI.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Model: claude-sonnet-4-6 (verified) or an Opus model
CLAUDE_MODEL=claude-sonnet-4-6
# Reasoning effort: high|low|max|medium  (Opus also supports xhigh)
CLAUDE_EFFORT=high

# Verification-pass tiering: run Pass 4 (the anchor-and-audit re-check) on a
# stronger model/effort than passes 1-3. Empty = same as CLAUDE_MODEL/EFFORT.
CLAUDE_VERIFY_MODEL=claude-opus-4-8
CLAUDE_VERIFY_EFFORT=xhigh

# Structured outputs: enforce a strict JSON Schema on every coding pass via
# the provider's structured-output API (kills the malformed-JSON error class
# at the source). 1=on (default), 0=off.
STRUCTURED_OUTPUTS=1

# Anthropic Message Batches API: every Claude call is submitted as a
# single-request batch — 50% off all tokens, same model, same output
# distribution; the only trade is latency (typically minutes per call).
# 1=on (default). Set 0 for latency-sensitive interactive runs.
ANTHROPIC_USE_BATCH=1
# Give up on a batch request after this many seconds (retryable timeout).
ANTHROPIC_BATCH_MAX_WAIT_S=7200

# [VESTIGIAL] Self-consistency: each note ran N independent app.pipeline
# times and any non-unanimous billing array routed to human review. The
# deployed entrypoint no longer reads either of these and REFUSES
# --consistency/--consistency-workers outright: claude_coder replaces the
# N-run comparison with built-in propose-then-verify plus independent
# cross-model corroboration. tools/unanimity_loop.py still reads them.
CONSISTENCY_RUNS=3
# Worker processes draining the batch-wide run queue (every note's N runs
# are submitted up front, so ~WORKERS/RUNS notes are in flight at once;
# 1=sequential). Each worker builds its own full pipeline instance (~1 min
# startup, ~1.5-3 GB RAM each); the runs are independent so results are
# identical to sequential — only wall time changes. Size to the box's RAM
# and the LLM provider's rate limits (measured: a 10M in / 2M out
# tokens-per-minute tier sustains 200+ concurrent runs; a 32 GB host
# sustains ~12 workers).
CONSISTENCY_WORKERS=12

# ── [VESTIGIAL] Verified-claim exemplars (few-shot from the claims registry) ──
# Injected into app/coding's prompts, which the deployed entrypoint no
# longer runs.
# Retrieval of similar VERIFIED encounters from data/registry as worked
# examples for the coding prompts.
#   auto   (default) shadow until the registry holds > EXEMPLAR_LIVE_THRESHOLD
#          verified claims, then live — the flip is automatic
#   shadow retrieve + record what WOULD be injected (rag_context.exemplars);
#          prompts unchanged (calibration phase, zero blast radius)
#   live   inject the exemplar block into the coding prompts
#   off    disabled
EXEMPLAR_MODE=auto
EXEMPLAR_LIVE_THRESHOLD=500
# Top-K exemplars per note and the minimum Jaccard similarity to qualify.
EXEMPLAR_TOP_K=3
EXEMPLAR_MIN_SIM=0.2

# ── [VESTIGIAL for the entrypoint] Clinical-correctness review ──
# (tools/clinical_auditor.py) The batch run no longer invokes the auditor —
# it consumed app.pipeline-shaped results. Still honoured when the tool is
# run by hand.
# The review IS the universal CLEAN gate: EVERY scrub-CLEAN claim is HELD
# at REVIEW until an authority-grounded expert-coder pass (1) upholds
# every interpretive layer correction — self-reported AND derived by
# diffing the claim before/after validation, so no layer can act unseen —
# and (2) finds nothing billing-material wrong in a whole-claim review
# (code selection, primary designation, missing documented codes,
# coverage logic, wrong system advisories). The uphold promotes to CLEAN;
# any disputed correction or material finding routes to the human queue
# AND enqueues an audit_dispute flip class for actuation (advisory
# findings enqueue without routing). Fail closed: setting 0 does not make
# claims CLEAN — it leaves them held at REVIEW unreviewed.
CLINICAL_AUDIT=1
# Independent review passes that must agree (correction disagreement ->
# uncertain -> REVIEW; an uncorroborated material finding degrades to
# advisory). 1 is the cost-efficient default; 2 hardens high-stakes
# batches.
CLINICAL_AUDIT_PASSES=1
CLINICAL_AUDITOR_MODEL=claude-fable-5

# ── [VESTIGIAL for the entrypoint] Audit convergence ──
# (tools/audit_convergence_loop.py) Not invoked by the batch run any more;
# still honoured when the tool is run by hand.
# What happens AFTER the review disputes a claim. 1 (default): a disputed
# review does not just sit in the human queue — the expert-coder
# adjudicator independently decides each grounded finding against the
# authoritative sources (N must-agree passes), applies it mechanically,
# replays it through the full deterministic stack, and re-reviews it; the
# upheld corrected claim is recorded at the adjudicated tier, which is
# the verified realignment target actuation needs to turn the fix into a
# deterministic rule/template/gate. The loop repeats (adjudicate ->
# actuate -> replay -> re-review) until the scope has no disputes or an
# iteration makes no progress — ONLY a stalled loop leaves disputes with
# a human. 0 restores the single review pass (every dispute goes
# straight to the human queue).
AUDIT_CONVERGENCE=1
AUDIT_CONVERGENCE_ITERATIONS=3
AUDIT_CONVERGENCE_ACTUATION_LIMIT=10

# ── Policy-grounded adjudication (tools/policy_corpus.py) ──
# The authoritative prose sources (MBPM Ch.15, ICD-10-CM Guidelines,
# NCCI Policy Manual) are fetched and kept current AUTONOMOUSLY: the
# adjudicator calls policy_corpus.ensure() before its first verdict,
# which fetches missing sources and re-checks stored ones against
# upstream every POLICY_CORPUS_MAX_AGE_DAYS. No manual fetch, no cron.
# With a corpus stored, every adjudication verdict resting on prose
# policy must quote the passage verbatim (verified deterministically;
# an invented quote voids the pass verdict), and quote-less prose
# verdicts record at the attested_only tier — visible for audit, never
# anchoring actuation. The protection activates when the corpus exists
# and degrades to the pre-corpus behavior when it doesn't.
POLICY_CORPUS_AUTOFETCH=1
POLICY_CORPUS_MAX_AGE_DAYS=30
# Optional cross-family second opinion: run adjudication passes after
# the first on a different model family, so must-agree unanimity crosses
# family boundaries (empty = same-model varied-temperature passes).
CODER_ADJUDICATOR_ALT_MODEL=

# ── [VESTIGIAL for the entrypoint] Pack consolidation ──
# (tools/pack_consolidation.py) Not invoked by the batch run any more;
# still honoured when the tool is run by hand.
# Runs at finalization: leave-one-out exercise scan over the stored
# corpus (cached by pack+corpus hash), dormant_on_corpus tags, and
# behavior-preserving rule merges gated on byte-identical corpus replay.
PACK_CONSOLIDATION=1
PACK_CONSOLIDATION_MERGE=1

# ── [VESTIGIAL] Coding memorandum (app/coding/memorandum.py) ──
# Compiled into app/coding's prompts, which the deployed entrypoint no
# longer runs.
# 1 (default): the rule pack's proven corrections (actuation rationales
# + authorities, filtered to scan-proven load-bearing rules) are
# compiled into a prompt block for all four coding passes, so the
# generative stage stops re-making error classes the deterministic
# stack already corrects. Recompiles automatically on pack change.
CODING_MEMORANDUM=1

# OpenAI (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o

# ── Vector store (Qdrant) ────────────────────────────────────
# Docker mode: docker-compose overrides this to http://qdrant:6333 — the
# value here is ignored inside the container.
# Native mode with a local server: http://localhost:6333
# Set EMPTY (QDRANT_URL=) to use the on-disk embedded store at QDRANT_PATH
# (no server needed; setup.sh does this automatically when no server is up).
QDRANT_URL=http://localhost:6333
QDRANT_PATH=data/qdrant_store

# ── Clearinghouse (eligibility / prior-auth / claim submission) ──
STEDI_API_KEY=test_REPLACE_ME
STEDI_ELIGIBILITY_URL=https://healthcare.us.stedi.com/2024-04-01/change/medicalnetwork/eligibility/v3
STEDI_CLAIMS_URL=https://healthcare.us.stedi.com/2024-04-01/change/medicalnetwork/professionalclaims/v3/submission
# "T" = test claims (default), "P" = production — flip deliberately.
STEDI_USAGE_INDICATOR=T
# [VESTIGIAL — and deliberately so] This used to let run.py transmit real
# 837P claims to the clearinghouse at the end of every batch. Transmission is
# irreversible and the submitter reads an app.pipeline-shaped result the
# deployed entrypoint no longer produces, so the entrypoint now submits
# NOTHING under any value here. Submission is an explicit, human-run step:
#   python tools/claim_submitter.py --dry-run
AUTO_SUBMIT_CLAIMS=0
# Dynamic claim envelope (fee schedule, NPIs/TIN, facility, payer filing
# codes) — hot-reloaded from this file on every submission run.
PRACTICE_CONFIG_PATH=data/practice_config.json

# ── Provenance terminal-head checkpoint anchor ───────────────
# (claude_coder/checkpoint.py — issue #6, F6-R4-A)
# The audit log is hash-chained and sealed into an HMAC witness journal. That
# pair CANNOT detect a consistent truncation (dropping the terminal durable row
# and the terminal journal entry together leaves a valid shorter history). The
# anchor is the expected terminal position, recorded in a store the audit writer
# can append to but cannot delete from or rewrite.
#
# THE DEPLOYED RUNTIME SETS BOTH OF THESE — this file documents them; it is not
# where the deployed values come from. On EC2, .env is materialised from Secrets
# Manager (terraform/secrets.tf, refreshed by ./refresh-secrets.sh), and
# PROVENANCE_CHECKPOINT_REQUIRED is additionally pinned in docker-compose.yml so
# a stale .env cannot silently switch the control off.
#
#   s3://<bucket>/<prefix>[?region=<region>]  the real backend, external trust
#                                             boundary (delete denied by IAM,
#                                             write-once objects, versioned)
#   file:<directory>                          REFERENCE backend only — same
#                                             filesystem/identity as the store
#                                             it anchors, NOT a trust boundary
#   none / unset                              no anchor; consistent truncation
#                                             is undetectable, and reported as
#                                             such in every audit artifact
# Terraform derives the deployed value from the bucket it creates; the literal
# below is illustrative. A spec this build cannot honour, or an anchor it cannot
# reach, REFUSES — it never degrades to "no anchor configured", so leaving the
# REPLACE_ME in place holds every encounter (loudly, by name) rather than
# quietly running unanchored. For LOCAL development without AWS, use
# PROVENANCE_CHECKPOINT_ANCHOR=file:data/checkpoints — a working anchor that
# honestly reports external_trust_boundary=false.
PROVENANCE_CHECKPOINT_ANCHOR=s3://REPLACE_ME-provenance-checkpoint/checkpoints?region=us-east-1
# 1 = running with NO configured anchor fails closed (SYSTEM_HOLD) instead of
# running self-anchored. This is the production posture; leave it on.
PROVENANCE_CHECKPOINT_REQUIRED=1
# ONE reviewed migration run, then unset. Lets a journal that PREDATES the
# anchor start being anchored mid-history. It is NOT a bypass: a store whose
# journal carries sealed evidence that it was already anchored still fails
# closed, because for that store an empty anchor means the checkpoint was
# destroyed. Every artifact produced while this is set records adoption_allowed.
PROVENANCE_CHECKPOINT_ADOPT=0
# Optional: the store's identity in the anchor, so several deployments can share
# one anchor bucket without colliding. Defaults to the provenance DB filename.
# PROVENANCE_STORE_ID=

# ── Encounter billing context (claim ownership) ───────────────
# Path to a JSON file declaring `billing_entity_id` and the encounter's
# participant roster (same schema as `python -m claude_coder.cli
# --billing-context`). The entrypoint passes it to every note.
#
# WITHOUT it, actor ownership resolves UNKNOWN and every claim line HOLDS
# before retrieval. That is fail-closed by design — the alternative is
# assuming the billing entity performed services the record does not tie to
# it — so this is left UNSET until a reviewed roster exists rather than
# defaulted to a guess.
# BILLING_CONTEXT_FILE=data/billing_context.json

# ── Misc ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
