    "data/codes/modifiers.json (AMA CPT Appendix A and CMS HCPCS Level II)",
    "data/global_periods.json (CMS Physician Fee Schedule indicators)",
    "data/codes/cpt_codes.json (licensed AMA descriptors)",
    "data/codes/cpt_categories.json (edition-bound licensed AMA category membership)",
    "data/codes/icd10cm_chapters.json (CDC/NCHS ICD-10-CM chapter structure)"
  ],
