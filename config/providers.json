{
  "profiles": [
    {
      "name": "openai-independent-extractor",
      "kind": "openai",
      "model": "gpt-5.6-sol",
      "endpoint": "https://api.openai.com/v1/responses",
      "api_key_env": "OPENAI_API_KEY",
      "timeout_seconds": 120,
      "max_attempts": 3,
      "max_document_characters": 250000,
      "reasoning_effort": "medium"
    },
    {
      "name": "anthropic-independent-extractor",
      "kind": "anthropic",
      "model": "claude-opus-4-8",
      "endpoint": "https://api.anthropic.com/v1/messages",
      "api_key_env": "ANTHROPIC_API_KEY",
      "timeout_seconds": 120,
      "max_attempts": 3,
      "max_document_characters": 250000,
      "reasoning_effort": "high"
    }
  ]
}
