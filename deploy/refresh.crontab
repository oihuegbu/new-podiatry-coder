# Compliance data refresh schedule — cadence per Claimly_Compliance_Data_Sources.xlsx
# Install:  crontab deploy/refresh.crontab   (adjust APP_DIR / PYTHON)
#
# All jobs are idempotent and history-retentive: re-running a quarter is a no-op,
# and old quarters are kept as effective-dated snapshots (CMS purges them).

APP_DIR=/opt/podiatry-medical-coder
PYTHON=/usr/bin/python3
# log dir must exist
SHELL=/bin/bash

# MCD Billing & Coding Articles — WEEKLY (highest-frequency source).
# Mondays 02:15.
15 2 * * 1   cd $APP_DIR && $PYTHON run_refresh.py --source mcd_articles   >> logs/refresh.log 2>&1

# NCCI PTP, MUE, PFS — QUARTERLY (Jan/Apr/Jul/Oct), 2nd of the month 03:00.
# CMS posts on the 1st; run the 2nd to be safe.
0 3 2 1,4,7,10 *   cd $APP_DIR && $PYTHON run_refresh.py --source ncci_ptp   >> logs/refresh.log 2>&1
0 3 2 1,4,7,10 *   cd $APP_DIR && $PYTHON run_refresh.py --source mue        >> logs/refresh.log 2>&1
0 3 2 1,4,7,10 *   cd $APP_DIR && $PYTHON run_refresh.py --source pfs_global  >> logs/refresh.log 2>&1

# HCPCS Level II — QUARTERLY.
30 3 2 1,4,7,10 *   cd $APP_DIR && $PYTHON run_refresh.py --source hcpcs      >> logs/refresh.log 2>&1

# ICD-10-CM — ANNUAL (effective Oct 1; load mid-September), 15th 04:00.
0 4 15 9 *   cd $APP_DIR && $PYTHON run_refresh.py --source icd10cm           >> logs/refresh.log 2>&1

# CPT — ANNUAL (effective Jan 1; AMA-licensed file), Dec 20th 04:00.
0 4 20 12 *   cd $APP_DIR && $PYTHON run_refresh.py --source cpt              >> logs/refresh.log 2>&1

# POS code set — ANNUAL refresh, Jan 5th.
0 4 5 1 *   cd $APP_DIR && $PYTHON run_refresh.py --source pos                >> logs/refresh.log 2>&1
